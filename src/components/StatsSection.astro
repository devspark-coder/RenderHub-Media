---
import { getStats } from '../lib/content';
const stats = await getStats();
---

{
  stats.length > 0 && (
    <section class="section stats" id="impact" aria-label="Impact numbers">
      <div class="stats-aura" aria-hidden="true">
        <span></span>
        <span></span>
      </div>
      <div class="wrap">
        <div class="stats__head reveal">
          <p class="kicker">Impact</p>
          <h2 class="section-title">Numbers that back the work</h2>
        </div>
        <dl class="stats-grid" data-stats-tilt>
          {stats.map((stat, i) => (
            <div class={`stat reveal d${(i % 4) + 1}`} data-tilt-card style={`--s:${i}`}>
              <div class="stat__face">
                <dt class="stat__value">
                  {stat.display ? (
                    <span>{stat.display}</span>
                  ) : (
                    <>
                      <span data-count={stat.value}>0</span>
                      {stat.suffix}
                    </>
                  )}
                </dt>
                <dd class="stat__label">{stat.label}</dd>
              </div>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}

<style>
  .stats {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.75rem, 7vw, 4.75rem);
    background: var(--ink);
    color: #fff;
    perspective: 1000px;
  }

  .stats-aura {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .stats-aura span {
    position: absolute;
    border-radius: 50%;
    filter: blur(40px);
    opacity: 0.45;
    animation: aura-drift 10s var(--ease) infinite alternate;
  }

  .stats-aura span:first-child {
    width: 18rem;
    height: 18rem;
    left: -4rem;
    top: -3rem;
    background: rgba(20, 184, 166, 0.35);
  }

  .stats-aura span:last-child {
    width: 16rem;
    height: 16rem;
    right: -3rem;
    bottom: -4rem;
    background: rgba(255, 255, 255, 0.12);
    animation-delay: 1.2s;
  }

  .stats .kicker {
    color: var(--signal-bright);
  }

  .stats .section-title {
    color: #fff;
    max-width: 12ch;
  }

  .stats__head {
    position: relative;
    z-index: 1;
    margin-bottom: 1.75rem;
  }

  @media (max-width: 720px) {
    .stats .section-title {
      font-size: clamp(1.7rem, 7vw, 2.4rem);
    }
  }

  .stats-grid {
    position: relative;
    z-index: 1;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.9rem;
  }

  @media (min-width: 700px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 18rem));
      gap: 1.1rem;
      justify-content: start;
    }
  }

  .stat {
    transform-style: preserve-3d;
  }

  .stat__face {
    height: 100%;
    padding: 1.25rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 1.1rem;
    background:
      linear-gradient(160deg, rgba(255, 255, 255, 0.1), rgba(255, 255, 255, 0.02)),
      rgba(255, 255, 255, 0.03);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.12);
    transform: rotateX(8deg) rotateY(calc((var(--s) - 1.5) * -3deg)) translateZ(0);
    transition:
      transform 0.45s var(--ease),
      box-shadow 0.45s var(--ease),
      border-color 0.45s var(--ease);
    transform-style: preserve-3d;
  }

  .stat:hover .stat__face,
  .stat:focus-within .stat__face {
    transform: rotateX(0deg) rotateY(0deg) translateY(-0.45rem) translateZ(18px) scale(1.02);
    border-color: rgba(20, 184, 166, 0.45);
    box-shadow:
      0 28px 55px rgba(0, 0, 0, 0.38),
      0 0 0 1px rgba(20, 184, 166, 0.15);
  }

  .stat__value {
    margin: 0 0 0.45rem;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 5.5vw, 3.35rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
    transform: translateZ(24px);
  }

  .stat__label {
    margin: 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 0.88rem;
    transform: translateZ(12px);
  }

  @keyframes aura-drift {
    from {
      transform: translate3d(0, 0, 0) scale(1);
    }
    to {
      transform: translate3d(8%, -6%, 0) scale(1.08);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stats-aura span,
    .stat__face {
      animation: none !important;
      transform: none !important;
    }
  }
</style>
