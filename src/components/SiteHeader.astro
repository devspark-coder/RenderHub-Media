---
import { getSite } from '../lib/content';
const site = await getSite();
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a class="site-header__brand" href="#top">
      <span class="site-header__mark" aria-hidden="true"></span>
      <span class="site-header__name">{site.name}</span>
    </a>

    <nav class="site-header__nav" id="mobile-nav" data-nav aria-label="Primary">
      <a href="#impact">Impact</a>
      <a href="#work">Work</a>
      <a href="#comments">Comments</a>
      <a href="#formats">Formats</a>
      <a href="#contact">Contact</a>
      <a class="btn btn-sm btn-primary site-header__nav-cta" href="#contact">Book a brief</a>
    </nav>

    <a class="btn btn-sm btn-primary site-header__cta" href="#contact">Book a brief</a>
    <button
      class="site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-nav-toggle
    >
      <span class="sr-only">Menu</span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const header = document.querySelector('.site-header');

  const setOpen = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('nav-lock', open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(!header?.classList.contains('is-open'));
  });

  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  const onScroll = () => {
    header?.classList.toggle('is-scrolled', window.scrollY > 12);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>

<style is:global>
  body.nav-lock {
    overflow: hidden;
  }
</style>

<style>
  .site-header {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    background: transparent;
    transition:
      background 0.35s var(--ease),
      border-color 0.35s var(--ease),
      backdrop-filter 0.35s var(--ease);
    border-bottom: 1px solid transparent;
  }

  .site-header.is-scrolled {
    background: rgba(246, 247, 249, 0.9);
    backdrop-filter: blur(18px);
    border-bottom-color: var(--line);
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    width: min(100% - 2rem, var(--max));
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-width: 0;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .site-header__brand:hover {
    color: var(--ink);
  }

  .site-header__mark {
    flex: 0 0 auto;
    width: 0.65rem;
    height: 0.65rem;
    background: var(--signal-bright);
  }

  .site-header__name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: clamp(0.88rem, 3.2vw, 1rem);
  }

  .site-header__nav {
    display: none;
  }

  .site-header__cta {
    margin-left: auto;
    display: none;
  }

  .site-header__toggle {
    margin-left: auto;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--line-strong);
    background: rgba(255, 255, 255, 0.65);
    display: inline-grid;
    place-content: center;
    gap: 0.35rem;
    cursor: pointer;
    border-radius: 0.35rem;
  }

  .site-header__toggle span:not(.sr-only) {
    display: block;
    width: 1rem;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.3s var(--ease);
  }

  .site-header.is-open .site-header__toggle span:not(.sr-only):first-of-type {
    transform: translateY(2.5px) rotate(45deg);
  }

  .site-header.is-open .site-header__toggle span:not(.sr-only):last-of-type {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  @media (max-width: 899px) {
    .site-header.is-open {
      background: rgba(246, 247, 249, 0.98);
    }

    .site-header.is-open .site-header__nav {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: var(--header-h) 0 0;
      padding: 1.75rem 1.5rem;
      gap: 0.15rem;
      background: rgba(246, 247, 249, 0.98);
      backdrop-filter: blur(18px);
      animation: nav-in 0.35s var(--ease) both;
    }

    .site-header.is-open .site-header__nav a:not(.btn) {
      padding: 1.05rem 0.15rem;
      font-size: 1.7rem;
      font-family: var(--font-display);
      font-weight: 700;
      letter-spacing: -0.03em;
      text-decoration: none;
      border-bottom: 1px solid var(--line);
    }

    .site-header__nav-cta {
      margin-top: 1.4rem;
      width: fit-content;
    }
  }

  @media (min-width: 900px) {
    .site-header__toggle {
      display: none;
    }

    .site-header__nav {
      display: flex;
      align-items: center;
      gap: 1.6rem;
      margin-left: auto;
      font-size: 0.9rem;
      font-weight: 550;
      color: var(--ink-soft);
    }

    .site-header__nav a:not(.btn) {
      text-decoration: none;
      position: relative;
    }

    .site-header__nav a:not(.btn)::after {
      content: '';
      position: absolute;
      left: 0;
      bottom: -0.25rem;
      width: 100%;
      height: 1px;
      background: var(--ink);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.35s var(--ease);
    }

    .site-header__nav a:not(.btn):hover::after {
      transform: scaleX(1);
    }

    .site-header__nav-cta {
      display: none;
    }

    .site-header__cta {
      display: inline-flex;
      margin-left: 0.35rem;
    }
  }

  @keyframes nav-in {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
