---
import { getProcess } from '../lib/content';
const steps = await getProcess();
---

<section class="section process" id="process" aria-labelledby="process-title">
  <div class="wrap">
    <div class="process__head">
      <div>
        <p class="kicker reveal">How we work</p>
        <h2 class="section-title reveal d1" id="process-title">Brief in. Renders out.</h2>
      </div>
      <p class="section-lead reveal d2">
        A short pipeline built for media pace — clear ownership at every step, no mystery middle.
      </p>
    </div>

  </div>

  <ol class="process-flow" data-carousel aria-label="Process steps">
    {
      steps.map((step, i) => (
        <li class={`process-step reveal d${(i % 4) + 1}`}>
          <div class="process-step__index">
            <span>{String(i + 1).padStart(2, '0')}</span>
            {i < steps.length - 1 && <span class="process-step__connector" aria-hidden="true" />}
          </div>
          <p class="process-step__label">{step.label}</p>
          <h3>{step.title}</h3>
          <p class="process-step__body">{step.body}</p>
        </li>
      ))
    }
  </ol>
  <p class="carousel-hint wrap">Swipe to browse →</p>

  <div class="wrap process__foot reveal">
    <a class="btn btn-primary" href="#contact">Start with a brief</a>
  </div>
</section>

<style>
  .process {
    background: var(--surface);
    padding-block: clamp(2.75rem, 7vw, 5rem);
  }

  .process__head {
    display: grid;
    gap: 0.85rem;
    margin-bottom: 1.75rem;
  }

  @media (min-width: 900px) {
    .process__head {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
      gap: 2rem;
    }

    .process__head .section-lead {
      margin-bottom: 0;
      justify-self: end;
      text-align: right;
    }
  }

  .process-flow {
    list-style: none;
    margin: 0;
    padding: 0.25rem max(1rem, calc((100% - var(--max)) / 2)) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(78%, 16rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  @media (min-width: 900px) {
    .process-flow {
      grid-template-columns: repeat(4, 1fr);
      grid-auto-flow: dense;
      grid-auto-columns: unset;
      overflow: visible;
      scroll-snap-type: none;
      width: min(100% - 2rem, var(--max));
      margin-inline: auto;
      padding-inline: 0;
      gap: 1.25rem;
    }
  }

  .process-step {
    position: relative;
    scroll-snap-align: start;
  }

  .process-step__index {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
  }

  .process-step__index > span:first-child {
    display: inline-grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 999px;
    background: var(--ink);
    color: #fff;
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    flex: 0 0 auto;
    z-index: 1;
  }

  .process-step__connector {
    display: none;
  }

  @media (min-width: 900px) {
    .process-step__connector {
      display: block;
      flex: 1;
      height: 2px;
      background: linear-gradient(90deg, var(--signal-bright), rgba(20, 184, 166, 0.15));
    }
  }

  .process-step__label {
    margin: 0 0 0.4rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .process-step h3 {
    font-size: clamp(1.4rem, 2.5vw, 1.7rem);
    margin-bottom: 0.5rem;
  }

  .process-step__body {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 18rem;
  }

  .process__foot {
    margin-top: 1.75rem;
  }

  .carousel-hint {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  @media (min-width: 900px) {
    .carousel-hint {
      display: none;
    }
  }
</style>
