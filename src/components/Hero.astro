---
import { getSite, getWork } from '../lib/content';
const site = await getSite();
const work = await getWork();
const previews = work.slice(0, 3);
---

<section class="hero" id="top" aria-labelledby="hero-brand" data-hero>
  <div class="hero-media" data-parallax aria-hidden="true">
    <img src="/hero-stage.jpg" alt="" width="1920" height="1080" fetchpriority="high" />
    <div class="hero-media__veil"></div>
  </div>

  <div class="hero-depth" aria-hidden="true">
    <span class="hero-depth__ring hero-depth__ring--a"></span>
    <span class="hero-depth__ring hero-depth__ring--b"></span>
    <span class="hero-depth__plane hero-depth__plane--a"></span>
    <span class="hero-depth__plane hero-depth__plane--b"></span>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-content">
      <p class="hero-eyebrow">Creative production hub</p>
      <p class="hero-brand" id="hero-brand">
        <span>RenderHub</span>
        <span>Media</span>
      </p>
      <h1 class="hero-copy">{site.tagline}</h1>
      <p class="hero-support">{site.supporting}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#contact">Book a brief</a>
        <a class="btn btn-ghost" href="#work">View work</a>
      </div>
    </div>

    <div class="hero-stage3d" data-tilt-stage aria-hidden="true">
      <div class="hero-stage3d__inner" data-tilt-inner>
        {
          previews.map((item, i) => (
            <a class={`hero-frame hero-frame--${i + 1}`} href="#work" tabindex="-1" data-tilt-layer={String(i + 1)}>
              <span class="hero-frame__glow"></span>
              <img src={item.poster} alt="" width="480" height="640" loading="eager" />
              <span class="hero-frame__tag">Showreel</span>
            </a>
          ))
        }
      </div>
    </div>
  </div>

  <div class="hero-strip" aria-label="Featured work preview">
    <div class="hero-strip__track">
      {
        previews.map((item) => (
          <a class="hero-strip__card" href="#work">
            <img src={item.poster} alt="" width="320" height="400" loading="eager" />
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: end;
    padding-top: var(--header-h);
    overflow: clip;
    perspective: 1200px;
  }

  @media (min-width: 980px) {
    .hero {
      min-height: 100svh;
      align-items: center;
      padding-bottom: 2rem;
    }
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: transform;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    transform: scale(1.06);
    animation: kenburns 22s var(--ease) both;
  }

  .hero-media__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        115deg,
        rgba(246, 247, 249, 0.96) 0%,
        rgba(246, 247, 249, 0.88) 34%,
        rgba(246, 247, 249, 0.42) 62%,
        rgba(246, 247, 249, 0.2) 100%
      ),
      linear-gradient(180deg, rgba(246, 247, 249, 0.2) 0%, rgba(246, 247, 249, 0.65) 100%);
  }

  .hero-depth {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: hidden;
  }

  .hero-depth__ring {
    position: absolute;
    border: 1px solid rgba(20, 184, 166, 0.28);
    border-radius: 50%;
    animation: orbit-spin 28s linear infinite;
  }

  .hero-depth__ring--a {
    width: min(58vw, 28rem);
    height: min(58vw, 28rem);
    right: -6%;
    top: 12%;
    box-shadow: inset 0 0 40px rgba(20, 184, 166, 0.08);
  }

  .hero-depth__ring--b {
    width: min(40vw, 18rem);
    height: min(40vw, 18rem);
    right: 18%;
    bottom: 18%;
    border-color: rgba(10, 10, 11, 0.12);
    animation-duration: 36s;
    animation-direction: reverse;
  }

  .hero-depth__plane {
    position: absolute;
    background: linear-gradient(135deg, rgba(20, 184, 166, 0.18), rgba(255, 255, 255, 0.05));
    border: 1px solid rgba(255, 255, 255, 0.35);
    backdrop-filter: blur(2px);
    transform-style: preserve-3d;
  }

  .hero-depth__plane--a {
    width: 7rem;
    height: 7rem;
    right: 12%;
    top: 22%;
    border-radius: 1rem;
    animation: float-y 7s var(--ease) infinite alternate;
    transform: rotateX(55deg) rotateZ(-18deg);
  }

  .hero-depth__plane--b {
    width: 4.5rem;
    height: 4.5rem;
    right: 32%;
    bottom: 28%;
    border-radius: 0.75rem;
    animation: float-y 9s var(--ease) infinite alternate-reverse;
    transform: rotateX(50deg) rotateZ(24deg);
    background: linear-gradient(135deg, rgba(10, 10, 11, 0.12), rgba(20, 184, 166, 0.12));
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 1.25rem;
    align-items: center;
    padding-block: 1.5rem 1rem;
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2rem;
      min-height: calc(100svh - var(--header-h) - 2rem);
      padding-block: 2rem;
    }
  }

  .hero-eyebrow {
    margin: 0 0 0.65rem;
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--signal);
    animation: rise 0.9s var(--ease) both;
  }

  .hero-brand {
    margin: 0 0 0.75rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.35rem, 10vw, 5.6rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    animation: rise 0.95s var(--ease) 0.05s both;
  }

  .hero-brand span {
    display: block;
    white-space: nowrap;
  }

  .hero-copy {
    margin: 0 0 0.7rem;
    font-size: clamp(1.1rem, 3.6vw, 1.75rem);
    max-width: 18ch;
    color: var(--ink-soft);
    font-weight: 650;
    letter-spacing: -0.03em;
    animation: rise 0.95s var(--ease) 0.1s both;
  }

  .hero-support {
    margin: 0 0 1.25rem;
    max-width: 34rem;
    color: var(--muted);
    font-size: clamp(0.92rem, 2vw, 1.06rem);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
    animation: rise 0.95s var(--ease) 0.16s both;
  }

  @media (min-width: 720px) {
    .hero-support {
      -webkit-line-clamp: unset;
      display: block;
      overflow: visible;
    }
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    animation: rise 0.95s var(--ease) 0.22s both;
  }

  .hero-stage3d {
    display: none;
  }

  @media (min-width: 980px) {
    .hero-stage3d {
      display: block;
      perspective: 1400px;
      min-height: 30rem;
      animation: rise 1s var(--ease) 0.18s both;
    }

    .hero-strip {
      display: none;
    }

    .hero-depth__plane {
      display: block;
    }
  }

  .hero-stage3d__inner {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 30rem;
    transform-style: preserve-3d;
    transition: transform 0.2s ease-out;
  }

  .hero-frame {
    position: absolute;
    width: min(58%, 17.5rem);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bg-2);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 1rem;
    box-shadow: var(--shadow-xl);
    text-decoration: none;
    color: #fff;
    transform-style: preserve-3d;
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }

  .hero-frame__glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(circle at 30% 20%, rgba(20, 184, 166, 0.35), transparent 55%);
    opacity: 0.65;
    pointer-events: none;
    z-index: 0;
  }

  .hero-frame img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-frame__tag {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    z-index: 2;
    padding: 0.35rem 0.55rem;
    background: rgba(10, 10, 11, 0.78);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-frame--1 {
    right: 6%;
    top: 2%;
    z-index: 3;
    transform: translateZ(60px) rotateY(-12deg) rotateX(6deg) rotateZ(3deg);
    animation: float-card-a 6.5s var(--ease) infinite alternate;
  }

  .hero-frame--2 {
    left: 2%;
    top: 18%;
    z-index: 2;
    width: min(48%, 14rem);
    transform: translateZ(20px) rotateY(14deg) rotateX(8deg) rotateZ(-7deg);
    animation: float-card-b 7.5s var(--ease) infinite alternate;
  }

  .hero-frame--3 {
    right: 16%;
    bottom: 2%;
    z-index: 1;
    width: min(42%, 12.5rem);
    transform: translateZ(40px) rotateY(-8deg) rotateX(10deg) rotateZ(8deg);
    animation: float-card-c 8s var(--ease) infinite alternate;
  }

  .hero-frame:hover {
    z-index: 5;
    box-shadow: 0 40px 90px rgba(10, 10, 11, 0.35);
  }

  .hero-strip {
    position: relative;
    z-index: 2;
    padding: 0 0 1.25rem;
  }

  .hero-strip__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(42%, 9.5rem);
    gap: 0.75rem;
    overflow-x: auto;
    padding: 0.15rem max(1rem, calc((100% - var(--max)) / 2)) 0.35rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    perspective: 800px;
  }

  .hero-strip__track::-webkit-scrollbar {
    display: none;
  }

  .hero-strip__card {
    scroll-snap-align: start;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 0.85rem;
    box-shadow: var(--shadow-md);
    transform: rotateY(-6deg);
    transition: transform 0.35s var(--ease);
  }

  .hero-strip__card:nth-child(2) {
    transform: rotateY(0deg) translateY(-0.35rem);
  }

  .hero-strip__card:nth-child(3) {
    transform: rotateY(6deg);
  }

  .hero-strip__card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.1rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes kenburns {
    from {
      transform: scale(1.1) translate3d(1%, 0, 0);
    }
    to {
      transform: scale(1.03);
    }
  }

  @keyframes float-y {
    from {
      transform: rotateX(52deg) rotateZ(-16deg) translateY(0);
    }
    to {
      transform: rotateX(52deg) rotateZ(-16deg) translateY(-1.1rem);
    }
  }

  @keyframes orbit-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes float-card-a {
    from {
      transform: translateZ(60px) rotateY(-12deg) rotateX(6deg) rotateZ(3deg) translateY(0);
    }
    to {
      transform: translateZ(70px) rotateY(-10deg) rotateX(4deg) rotateZ(2deg) translateY(-0.85rem);
    }
  }

  @keyframes float-card-b {
    from {
      transform: translateZ(20px) rotateY(14deg) rotateX(8deg) rotateZ(-7deg) translateY(0);
    }
    to {
      transform: translateZ(30px) rotateY(12deg) rotateX(6deg) rotateZ(-5deg) translateY(-1.1rem);
    }
  }

  @keyframes float-card-c {
    from {
      transform: translateZ(40px) rotateY(-8deg) rotateX(10deg) rotateZ(8deg) translateY(0);
    }
    to {
      transform: translateZ(50px) rotateY(-6deg) rotateX(8deg) rotateZ(6deg) translateY(-0.7rem);
    }
  }

  @media (max-width: 979px) {
    .hero-depth__plane {
      display: none;
    }

    .hero-depth__ring--a {
      opacity: 0.45;
      right: -18%;
      top: auto;
      bottom: 8%;
    }

    .hero-depth__ring--b {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .hero-media__veil {
      background:
        linear-gradient(180deg, rgba(246, 247, 249, 0.55) 0%, rgba(246, 247, 249, 0.92) 58%, var(--bg) 100%),
        linear-gradient(90deg, rgba(246, 247, 249, 0.8), rgba(246, 247, 249, 0.3) 90%);
    }

    .hero-brand {
      font-size: min(11vw, calc((100vw - 2.5rem) / 8.2));
    }

    .hero-ctas .btn {
      flex: 1 1 8.5rem;
      min-height: 2.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-depth__ring,
    .hero-depth__plane,
    .hero-frame--1,
    .hero-frame--2,
    .hero-frame--3 {
      animation: none !important;
    }
  }
</style>
