---
import { getSite, getWork } from '../lib/content';
const site = await getSite();
const work = await getWork();
const previews = work.slice(0, 3);
---

<section class="hero" id="top" aria-labelledby="hero-brand">
  <div class="hero-media" data-parallax aria-hidden="true">
    <img src="/hero-stage.jpg" alt="" width="1920" height="1080" fetchpriority="high" />
    <div class="hero-media__veil"></div>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-content">
      <p class="hero-eyebrow">Creative production hub</p>
      <p class="hero-brand" id="hero-brand">
        <span>RenderHub</span>
        <span>Media</span>
      </p>
      <h1 class="hero-copy">{site.tagline}</h1>
      <p class="hero-support">{site.supporting}</p>
      <div class="hero-ctas">
        <a class="btn btn-primary" href="#contact">Book a brief</a>
        <a class="btn btn-ghost" href="#work">View selected work</a>
      </div>
    </div>

    <div class="hero-showreel" aria-hidden="true">
      {
        previews.map((item, i) => (
          <a
            class={`hero-frame hero-frame--${i + 1}`}
            href="#work"
            tabindex="-1"
            style={`--i:${i}`}
          >
            <img src={item.poster} alt="" width="480" height="640" loading="eager" />
            <span>Showreel</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-top: var(--header-h);
    padding-bottom: 2.5rem;
    overflow: clip;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    z-index: 0;
    will-change: transform;
  }

  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% center;
    transform: scale(1.06);
    animation: kenburns 22s var(--ease) both;
  }

  .hero-media__veil {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        115deg,
        rgba(246, 247, 249, 0.96) 0%,
        rgba(246, 247, 249, 0.88) 34%,
        rgba(246, 247, 249, 0.42) 62%,
        rgba(246, 247, 249, 0.2) 100%
      ),
      linear-gradient(180deg, rgba(246, 247, 249, 0.2) 0%, rgba(246, 247, 249, 0.65) 100%);
  }

  .hero-grid {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 2.5rem;
    align-items: center;
    padding-block: clamp(2rem, 7vh, 4rem);
  }

  @media (min-width: 980px) {
    .hero-grid {
      grid-template-columns: 1.05fr 0.95fr;
      gap: 2rem;
      min-height: calc(100svh - var(--header-h) - 2.5rem);
    }
  }

  .hero-eyebrow {
    margin: 0 0 0.85rem;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--signal);
    animation: rise 0.9s var(--ease) both;
  }

  .hero-brand {
    margin: 0 0 1rem;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.5rem, 8vw, 5.6rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    animation: rise 0.95s var(--ease) 0.05s both;
  }

  .hero-brand span {
    display: block;
    white-space: nowrap;
  }

  .hero-copy {
    margin: 0 0 0.95rem;
    font-size: clamp(1.2rem, 2.8vw, 1.75rem);
    max-width: 18ch;
    color: var(--ink-soft);
    font-weight: 650;
    letter-spacing: -0.03em;
    animation: rise 0.95s var(--ease) 0.1s both;
  }

  .hero-support {
    margin: 0 0 1.7rem;
    max-width: 34rem;
    color: var(--muted);
    font-size: clamp(0.98rem, 2vw, 1.06rem);
    animation: rise 0.95s var(--ease) 0.16s both;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    animation: rise 0.95s var(--ease) 0.22s both;
  }

  .hero-showreel {
    position: relative;
    min-height: 22rem;
    display: none;
  }

  @media (min-width: 980px) {
    .hero-showreel {
      display: block;
      min-height: 28rem;
      animation: rise 1s var(--ease) 0.18s both;
    }
  }

  .hero-frame {
    position: absolute;
    width: min(58%, 17.5rem);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bg-2);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow: var(--shadow-lg);
    text-decoration: none;
    color: #fff;
    transition: transform 0.5s var(--ease);
  }

  .hero-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero-frame span {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.35rem 0.55rem;
    background: rgba(10, 10, 11, 0.78);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero-frame--1 {
    right: 8%;
    top: 4%;
    z-index: 3;
    transform: rotate(3deg);
  }

  .hero-frame--2 {
    left: 4%;
    top: 18%;
    z-index: 2;
    width: min(48%, 14rem);
    transform: rotate(-6deg);
  }

  .hero-frame--3 {
    right: 18%;
    bottom: 0;
    z-index: 1;
    width: min(42%, 12.5rem);
    transform: rotate(7deg);
  }

  .hero-frame:hover {
    transform: translateY(-0.4rem) rotate(0deg) scale(1.02);
    z-index: 4;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes kenburns {
    from {
      transform: scale(1.1) translate3d(1%, 0, 0);
    }
    to {
      transform: scale(1.03);
    }
  }

  @media (max-width: 720px) {
    .hero-media__veil {
      background:
        linear-gradient(180deg, rgba(246, 247, 249, 0.45) 0%, rgba(246, 247, 249, 0.9) 55%, var(--bg) 100%),
        linear-gradient(90deg, rgba(246, 247, 249, 0.75), rgba(246, 247, 249, 0.25) 90%);
    }

    .hero-brand {
      font-size: min(11vw, calc((100vw - 2.5rem) / 8.2));
    }

    .hero-ctas .btn {
      flex: 1 1 9.5rem;
    }
  }
</style>
