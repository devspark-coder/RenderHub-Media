---
import { getWork } from '../lib/content';
const work = await getWork();
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="wrap work__head">
    <div>
      <p class="kicker reveal">Selected work</p>
      <h2 class="section-title reveal d1" id="work-title">Our Work Speaks for Itself</h2>
    </div>
    <p class="section-lead reveal d2">
      Explore our latest video edits across social media, podcasts, fitness, lifestyle, business, and more.
    </p>
  </div>

  <div class="work-carousel" data-carousel tabindex="0" aria-label="Work carousel">
    {
      work.map((item, i) => (
        <a
          class={`work-card reveal-scale d${(i % 4) + 1}`}
          href={item.driveUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <div class="work-card__media">
            {item.videoSrc ? (
              <video
                class="work-card__video"
                muted
                loop
                playsinline
                preload="metadata"
                poster={item.poster}
                data-work-video
              >
                <source src={item.videoSrc} type="video/mp4" />
              </video>
            ) : (
              <img src={item.poster} alt="" width="720" height="960" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            )}
            <span class="work-card__play" aria-hidden="true">▶</span>
          </div>
          <div class="work-card__meta">
            <h3>{item.title}</h3>
            <p>
              {item.format} · {item.platform}
            </p>
          </div>
        </a>
      ))
    }
  </div>
  <p class="carousel-hint wrap">Swipe to browse →</p>
</section>

<style>
  .work {
    padding-top: clamp(2.75rem, 7vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .work__head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 900px) {
    .work__head {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .work__head .section-lead {
      margin-bottom: 0;
      justify-self: end;
      text-align: right;
    }
  }

  .work-carousel {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(78%, 18rem);
    gap: 1rem;
    overflow-x: auto;
    padding: 0.35rem max(1rem, calc((100% - var(--max)) / 2)) 0.75rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    cursor: grab;
  }

  @media (min-width: 700px) {
    .work-carousel {
      grid-auto-columns: minmax(42%, 17rem);
    }
  }

  @media (min-width: 1100px) {
    .work-carousel {
      grid-auto-columns: minmax(22%, 18rem);
    }
  }

  .work-carousel:active {
    cursor: grabbing;
  }

  .work-card {
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .work-card:hover {
    color: inherit;
  }

  .work-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--bg-2);
    border-radius: 1rem;
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.45s var(--ease);
  }

  .work-card:hover .work-card__media,
  .work-card:focus-visible .work-card__media {
    box-shadow: var(--shadow-lg);
  }

  .work-card__media img,
  .work-card__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .work-card__play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(10, 10, 11, 0.72);
    color: #fff;
    font-size: 0.7rem;
  }

  .work-card:hover .work-card__media img,
  .work-card:hover .work-card__video {
    transform: scale(1.045);
  }

  .work-card__meta {
    padding-top: 0.85rem;
  }

  .work-card__meta h3 {
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    margin-bottom: 0.2rem;
  }

  .work-card__meta p {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .carousel-hint {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
    letter-spacing: 0.04em;
  }

  @media (min-width: 1100px) {
    .carousel-hint {
      display: none;
    }
  }
</style>
