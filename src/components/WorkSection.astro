---
import { getWork } from '../lib/content';
const work = await getWork();
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="wrap work__head">
    <div>
      <p class="kicker reveal">Selected work</p>
      <h2 class="section-title reveal d1" id="work-title">Our Work Speaks for Itself</h2>
    </div>
    <p class="section-lead reveal d2">
      Explore our latest video edits across social media, podcasts, fitness, lifestyle, business, and more.
    </p>
  </div>

  <div class="work-loop" data-work-loop aria-label="Work showcase looping carousel">
    <div class="work-loop__track">
      <div class="work-loop__group">
        {
          work.map((item, i) => (
            <a
              class="work-card"
              href={item.driveUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <div class="work-card__media">
                {item.videoSrc ? (
                  <video
                    class="work-card__video"
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster={item.poster}
                    data-work-video
                  >
                    <source src={item.videoSrc} type="video/mp4" />
                  </video>
                ) : (
                  <img
                    src={item.poster}
                    alt=""
                    width="720"
                    height="960"
                    loading={i < 3 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                )}
                <span class="work-card__play" aria-hidden="true">▶</span>
              </div>
              <div class="work-card__meta">
                <h3>{item.title}</h3>
                <p>
                  {item.format} · {item.platform}
                </p>
              </div>
            </a>
          ))
        }
      </div>
      <div class="work-loop__group" aria-hidden="true">
        {
          work.map((item) => (
            <a
              class="work-card"
              href={item.driveUrl}
              target="_blank"
              rel="noopener noreferrer"
              tabindex="-1"
            >
              <div class="work-card__media">
                {item.videoSrc ? (
                  <video
                    class="work-card__video"
                    muted
                    loop
                    playsinline
                    preload="metadata"
                    poster={item.poster}
                  >
                    <source src={item.videoSrc} type="video/mp4" />
                  </video>
                ) : (
                  <img src={item.poster} alt="" width="720" height="960" loading="lazy" decoding="async" />
                )}
                <span class="work-card__play" aria-hidden="true">▶</span>
              </div>
              <div class="work-card__meta">
                <h3>{item.title}</h3>
                <p>
                  {item.format} · {item.platform}
                </p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </div>
  <p class="work-loop__note wrap">Hover to pause · Click a card to open the Drive reel</p>
</section>

<style>
  .work {
    padding-top: clamp(2.75rem, 7vw, 5rem);
    padding-bottom: clamp(2.5rem, 6vw, 4rem);
    overflow: hidden;
  }

  .work__head {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 900px) {
    .work__head {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: end;
      gap: 2rem;
      margin-bottom: 2rem;
    }

    .work__head .section-lead {
      margin-bottom: 0;
      justify-self: end;
      text-align: right;
    }
  }

  .work-loop {
    position: relative;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .work-loop__track {
    display: flex;
    width: max-content;
    animation: work-marquee 55s linear infinite;
    animation-play-state: paused;
    will-change: transform;
  }

  .work-loop.is-active .work-loop__track {
    animation-play-state: running;
  }

  .work-loop.is-active:hover .work-loop__track,
  .work-loop.is-active:focus-within .work-loop__track {
    animation-play-state: paused;
  }

  .work-loop__group {
    display: flex;
    gap: 1rem;
    padding-inline: 0.5rem;
  }

  .work-card {
    flex: 0 0 auto;
    width: min(72vw, 16.5rem);
    text-decoration: none;
    color: inherit;
    display: block;
  }

  @media (min-width: 700px) {
    .work-card {
      width: 16.5rem;
    }
  }

  .work-card:hover {
    color: inherit;
  }

  .work-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3 / 4;
    background: var(--bg-2);
    border-radius: 1rem;
    box-shadow: var(--shadow-md);
    transition: box-shadow 0.45s var(--ease);
  }

  .work-card:hover .work-card__media,
  .work-card:focus-visible .work-card__media {
    box-shadow: var(--shadow-lg);
  }

  .work-card__media img,
  .work-card__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }

  .work-card__play {
    position: absolute;
    inset: 50% auto auto 50%;
    translate: -50% -50%;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 999px;
    background: rgba(10, 10, 11, 0.72);
    color: #fff;
    font-size: 0.7rem;
  }

  .work-card:hover .work-card__media img,
  .work-card:hover .work-card__video {
    transform: scale(1.045);
  }

  .work-card__meta {
    padding-top: 0.85rem;
  }

  .work-card__meta h3 {
    font-size: clamp(1.05rem, 2.4vw, 1.25rem);
    margin-bottom: 0.2rem;
  }

  .work-card__meta p {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .work-loop__note {
    margin-top: 0.85rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 600;
  }

  @keyframes work-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-loop__track {
      animation: none;
      flex-wrap: wrap;
      width: min(100% - 2rem, var(--max));
      margin-inline: auto;
      justify-content: center;
    }

    .work-loop__group:last-child {
      display: none;
    }

    .work-loop__group {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0;
      gap: 1rem;
    }

    .work-loop {
      mask-image: none;
      -webkit-mask-image: none;
      overflow: visible;
    }
  }
</style>
