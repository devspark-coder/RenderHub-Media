---
import { getWork } from '../lib/content';
const work = await getWork();
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="wrap work__head">
    <div>
      <p class="kicker reveal">Selected renders</p>
      <h2 class="section-title reveal d1" id="work-title">Work that already looks live in an ad account</h2>
    </div>
    <p class="section-lead reveal d2">
      Scroll the strip. Open any piece for the full Drive reel.
    </p>
  </div>

  <div class="work-strip" data-strip tabindex="0" aria-label="Work carousel">
    {
      work.map((item, i) => (
        <a
          class={`work-card reveal-scale d${(i % 4) + 1}`}
          href={item.driveUrl}
          target="_blank"
          rel="noopener noreferrer"
          style={`--i:${i}`}
        >
          <div class="work-card__media">
            <img src={item.poster} alt="" width="480" height="600" loading="lazy" />
            <span>Open reel</span>
          </div>
          <div class="work-card__meta">
            <h3>{item.title}</h3>
            <p>
              {item.format} · {item.platform}
            </p>
          </div>
        </a>
      ))
    }
  </div>
</section>

<style>
  .work {
    padding-top: 4rem;
  }

  .work__head {
    display: grid;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 900px) {
    .work__head {
      grid-template-columns: 1.3fr 0.8fr;
      align-items: end;
    }

    .work__head .section-lead {
      margin-bottom: 0;
      justify-self: end;
      text-align: right;
    }
  }

  .work-strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(16rem, 22rem);
    gap: 1.1rem;
    overflow-x: auto;
    padding: 0.5rem max(1rem, calc((100% - var(--max)) / 2)) 1.5rem;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    cursor: grab;
  }

  .work-strip:active {
    cursor: grabbing;
  }

  .work-card {
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .work-card:hover {
    color: inherit;
  }

  .work-card__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid var(--line);
    background: var(--panel);
  }

  .work-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }

  .work-card__media span {
    position: absolute;
    left: 0.85rem;
    bottom: 0.85rem;
    padding: 0.4rem 0.65rem;
    background: var(--ink);
    color: var(--snow);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transform: translateY(120%);
    transition: transform 0.45s var(--ease);
  }

  .work-card:hover .work-card__media img {
    transform: scale(1.06) rotate(-0.5deg);
  }

  .work-card:hover .work-card__media span {
    transform: none;
  }

  .work-card__meta {
    padding-top: 0.85rem;
  }

  .work-card__meta h3 {
    font-size: 1.35rem;
    margin-bottom: 0.2rem;
  }

  .work-card__meta p {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
