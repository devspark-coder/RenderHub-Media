---
import { getFormats } from '../lib/content';
const formats = await getFormats();
---

<section class="section formats" id="formats" aria-labelledby="formats-title">
  <div class="wrap formats__layout">
    <div class="formats__intro reveal-left">
      <p class="kicker">Formats</p>
      <h2 class="section-title" id="formats-title">Every render your buyer can actually run</h2>
      <p class="section-lead">A hub of formats — not a single freelancer hoping one cut lands.</p>
    </div>

    <ol class="format-list">
      {
        formats.map((f, i) => (
          <li class={`format-row reveal d${(i % 4) + 1}`}>
            <span class="format-row__n">{f.label}</span>
            <div class="format-row__body">
              <h3>{f.title}</h3>
              <p>{f.blurb}</p>
            </div>
            <span class="format-row__arrow" aria-hidden="true">↗</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .formats {
    background:
      linear-gradient(180deg, transparent, rgba(207, 244, 252, 0.35) 40%, transparent),
      var(--mist);
  }

  .formats__layout {
    display: grid;
    gap: 2.5rem;
  }

  @media (min-width: 960px) {
    .formats__layout {
      grid-template-columns: 0.85fr 1.25fr;
      gap: 4rem;
      align-items: start;
    }

    .formats__intro {
      position: sticky;
      top: 6rem;
    }
  }

  .format-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .format-row {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 1rem;
    align-items: start;
    padding: 1.5rem 0.25rem;
    border-top: 1px solid var(--line-strong);
    transition: background 0.35s var(--ease), padding-left 0.35s var(--ease);
  }

  .format-row:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .format-row:hover {
    background: rgba(255, 255, 255, 0.45);
    padding-left: 0.75rem;
  }

  .format-row__n {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cyan);
    padding-top: 0.45rem;
  }

  .format-row__body h3 {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin-bottom: 0.4rem;
  }

  .format-row__body p {
    color: var(--muted);
    max-width: 36rem;
  }

  .format-row__arrow {
    font-size: 1.4rem;
    color: var(--cobalt);
    transform: translateY(0.35rem) rotate(-12deg);
    transition: transform 0.35s var(--ease);
  }

  .format-row:hover .format-row__arrow {
    transform: translateY(0.15rem) rotate(0deg) scale(1.1);
  }

  @media (max-width: 640px) {
    .format-row {
      grid-template-columns: 1fr auto;
    }

    .format-row__n {
      grid-column: 1 / -1;
    }
  }
</style>
