---
import { getFormats } from '../lib/content';
const formats = await getFormats();
---

<section class="section formats" id="formats" aria-labelledby="formats-title">
  <div class="wrap">
    <div class="formats__head">
      <p class="kicker reveal">Capabilities</p>
      <h2 class="section-title reveal d1" id="formats-title">Formats buyers can actually run</h2>
      <p class="section-lead reveal d2">
        Four production lanes under one hub — swipe to browse on mobile.
      </p>
    </div>
  </div>

  <ul class="format-carousel" data-carousel aria-label="Formats carousel">
    {
      formats.map((f, i) => (
        <li class={`format-card reveal-scale d${(i % 4) + 1}`}>
          <span class="format-card__n">{f.label}</span>
          <h3>{f.title}</h3>
          <p>{f.blurb}</p>
        </li>
      ))
    }
  </ul>
  <p class="carousel-hint wrap">Swipe to browse →</p>
</section>

<style>
  .formats {
    background: var(--bg-2);
    padding-block: clamp(2.75rem, 7vw, 5rem);
  }

  .formats__head {
    max-width: 38rem;
    margin-bottom: 1.5rem;
  }

  .format-carousel {
    list-style: none;
    margin: 0;
    padding: 0.25rem max(1rem, calc((100% - var(--max)) / 2)) 0.5rem;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(82%, 18rem);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
  }

  @media (min-width: 700px) {
    .format-carousel {
      grid-auto-columns: minmax(40%, 20rem);
    }
  }

  @media (min-width: 1100px) {
    .format-carousel {
      grid-auto-flow: dense;
      grid-template-columns: repeat(2, 1fr);
      grid-auto-columns: unset;
      overflow: visible;
      scroll-snap-type: none;
      width: min(100% - 2rem, var(--max));
      margin-inline: auto;
      padding-inline: 0;
    }
  }

  .format-card {
    scroll-snap-align: start;
    display: grid;
    gap: 0.7rem;
    align-content: start;
    min-height: 12.5rem;
    padding: 1.35rem 1.25rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    box-shadow: var(--shadow-sm);
  }

  .format-card__n {
    display: inline-flex;
    width: fit-content;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--signal-soft);
    color: var(--signal);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .format-card h3 {
    font-size: clamp(1.35rem, 3vw, 1.75rem);
  }

  .format-card p {
    color: var(--muted);
    font-size: 0.92rem;
  }

  .carousel-hint {
    margin-top: 0.35rem;
    color: var(--muted);
    font-size: 0.78rem;
    font-weight: 650;
  }

  @media (min-width: 1100px) {
    .carousel-hint {
      display: none;
    }
  }
</style>
