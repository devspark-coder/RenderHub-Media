---
import { getFormats } from '../lib/content';
const formats = await getFormats();
---

<section class="section formats" id="formats" aria-labelledby="formats-title">
  <div class="wrap">
    <div class="formats__head">
      <p class="kicker reveal">Capabilities</p>
      <h2 class="section-title reveal d1" id="formats-title">Formats buyers can actually run</h2>
      <p class="section-lead reveal d2">
        Four production lanes under one hub — pick what your accounts need this week.
      </p>
    </div>

    <ul class="format-grid">
      {
        formats.map((f, i) => (
          <li class={`format-card reveal-scale d${(i % 4) + 1}`}>
            <span class="format-card__n">{f.label}</span>
            <h3>{f.title}</h3>
            <p>{f.blurb}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .formats {
    background: var(--bg-2);
  }

  .formats__head {
    max-width: 38rem;
    margin-bottom: 2.5rem;
  }

  .format-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 700px) {
    .format-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.15rem;
    }
  }

  .format-card {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    min-height: 14rem;
    padding: 1.5rem 1.4rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 1.15rem;
    box-shadow: var(--shadow-sm);
    transition:
      transform 0.4s var(--ease),
      box-shadow 0.4s var(--ease),
      border-color 0.4s var(--ease);
  }

  .format-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: var(--line-strong);
  }

  .format-card__n {
    display: inline-flex;
    width: fit-content;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    background: var(--signal-soft);
    color: var(--signal);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .format-card h3 {
    font-size: clamp(1.45rem, 3vw, 1.85rem);
  }

  .format-card p {
    color: var(--muted);
    font-size: 0.95rem;
    max-width: 28rem;
  }
</style>
